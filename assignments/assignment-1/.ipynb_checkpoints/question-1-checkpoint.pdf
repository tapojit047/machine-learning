   "source": [
    "### c. Mean, Median, and Standard Deviation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "6d7233ef-8479-4590-92dc-4345084dd1d9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mean Total Sale:  325.422\n",
      "Median Total Sale:  300.0\n",
      "Standard Deviation of Total Sale:  133.83027970779509\n"
     ]
    }
   ],
   "source": [
    "mean_sale = df[\"Total_Sale\"].mean()\n",
    "median_sale = df[\"Total_Sale\"].median()\n",
    "std_sale = df[\"Total_Sale\"].std()\n",
    "\n",
    "print(\"Mean Total Sale: \", mean_sale)\n",
    "print(\"Median Total Sale: \", median_sale)\n",
    "print(\"Standard Deviation of Total Sale: \", std_sale);"
   ]
  },
